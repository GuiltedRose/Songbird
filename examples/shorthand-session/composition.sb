project "Native and Mini percussion shorthand"
tempo 140
signature 4/4
bars 4
rate 48000
bits 24
track drums {
    s("bd*2,oh*4").end("<.1 .2 .5 1>").fast(2)
    cycles 4
    gain -15db
}
track accents {
    s("[rim <hh cb>]*2").dec(.4)
    cycles 4
    gain -18db
}
track melody {
    synth triangle
    notation mini
    notes "c4 <e4 g4>"
    cycles 4
    gain -18db
}
track bass {
    synth sine
    notes "C2:2 G2:2"
    loop
    gain -15db
}
master limit -1
