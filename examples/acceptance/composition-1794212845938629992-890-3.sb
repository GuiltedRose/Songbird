project "Midnight Garden"
tempo 140
signature 4/4
bars 8
rate 48000
bits 24
let bassline "(C2 - C2 G2) (Bb2 - G2 -)"
track drums {
 instrument "drumkit"
 pattern "kick hat snare hat kick kick snare hat"
 gain -9db
 loop
}
track bass {
 synth "analog"
 notes $bassline
 adsr 0.008 0.15 0.45 0.08
 filter 900
 gain -8db
 loop
}
track melody {
 synth "triangle"
 notes "[C4,E4,G4]:1 -:1 [Bb3,D4,F4]:1 G4:1"
 gain -9db
 reverb 0.2
 pan 0.15
 loop
}
master limit -1

voice Analytic { language english; bank voices/analytic; register alto }
track singer { use voice Analytic; lyrics "ah ~ ah ~"; notes "C4:2 E4:2 G4:2 E4:2"; at 8b; vibrato 0.2; breathiness 0.05; gain -7db; reverb 0.15 }
track bell {import samples/bell.flac; at 4b; gain -6db; pan -0.25; delay 0.22 0.3 0.2}
track texture {import samples/texture.wav; trim 0.1 1.8; reverse; fade in 80ms; fade out 200ms; place at 8b; duplicate 16b; pitch 3; gain -9db; pan 0.35}
