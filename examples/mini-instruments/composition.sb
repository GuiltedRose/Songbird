project "Mini Acoustic Ensemble"
tempo 96
signature 4/4
bars 8
rate 48000
bits 24
master limit -1

track guitar {
    note("[c3,e3,g3] ~ [f3,a3,c4] <[g3,b3,d4] [g3,b3,f4]>").s("nylon-guitar")
    loop
    gain -12db
    pan -0.25
}
track bass {
    note("c2 <g2 e2> f2 g2").sound("upright-bass").end(.85)
    loop
    gain -10db
}
track keys {
    note("~ [c4,e4] ~ <[d4,g4] [b3,f4]>").s("electric-piano").slow(2)
    loop
    gain -15db
    pan 0.25
    reverb 0.12
}
track melody {
    note("[e4 g4] <a4 c5> ~ [g4 d4]").s("clarinet").end("<.9 .7>")
    loop
    gain -14db
    reverb 0.15
}
track percussion {
    s("sh*4 rim ~ rim").dec(.15)
    loop
    gain -20db
}
