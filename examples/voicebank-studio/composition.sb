project "Voicebank Studio — synthetic fixture"
tempo 120
signature 4/4
bars 4
rate 48000
bits 24
track drums {
    instrument drumkit
    pattern "kick hat snare hat"
    gain -18db
    loop
}
track bass {
    synth triangle
    notes "A2:2 G2:2"
    filter 800
    gain -15db
    loop
}
track backing {
    vocal-preset "voices/studio-synthetic/preset-Soft-Harmony.toml"
    lyrics "me see me see"
    notes "A3:1 B3:1 G3:1 A3:1"
    loop
}
master limit -1
